# The grading container for `npm run grade:docker`. Students' code runs in here,
# never directly on your computer. It's built from this checkout, so it grades
# with your copy of the tests and rubrics.
FROM node:24.21.0-bookworm-slim
# grade:docker removes old images with this label after each build.
LABEL org.cis591.role=copper-grader

ARG GH_VERSION=2.101.0
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git \
  && arch="$(dpkg --print-architecture)" \
  && curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${arch}.tar.gz" \
    | tar -xz -C /tmp \
  && mv /tmp/gh_${GH_VERSION}_linux_${arch}/bin/gh /usr/local/bin/gh \
  && rm -rf /tmp/gh_* \
  && apt-get purge -y curl \
  && apt-get autoremove -y \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# Packages first, so they're only reinstalled when the lockfile changes.
COPY package.json package-lock.json .npmrc ./
# Clearing npm's download cache in the same step keeps it out of the image.
RUN npm ci --no-audit --no-fund && npm cache clean --force
COPY . .

# The grader runs as root; each student's code runs as user 20000 + n.
ENV GRADE_STUDENT_UID_BASE=20000
CMD ["node", "scripts/grade/grade.mjs"]
